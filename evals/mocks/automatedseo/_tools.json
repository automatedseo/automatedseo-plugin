  {
   "name": "reschedule_article",
   "title": "Reschedule article",
   "description": "Move a planned article that hasn't started generating to another day in the content calendar. One article per day; days reserved for improving existing pages are unavailable. timeZone is the person's IANA time zone, used to decide which calendar day scheduledAt falls on.",
