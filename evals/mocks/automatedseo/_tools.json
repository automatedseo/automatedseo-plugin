  {
   "name": "get_content_calendar",
   "title": "Get content calendar",
   "description": "Return scheduled and recently updated content for the selected website.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
     },
     "websiteId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
     },
     "from": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
     },
     "to": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
     },
     "limit": {
      "default": 50,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
     }
    },
    "required": [
     "workspaceId",
     "websiteId"
    ]
   },
   "annotations": {
    "title": "Get content calendar",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   },
   "securitySchemes": [
    {
     "type": "oauth2",
