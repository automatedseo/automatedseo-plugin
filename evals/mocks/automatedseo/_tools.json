     },
     "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     },
     "expectedVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
     }
    },
    "required": [
     "workspaceId",
     "websiteId",
     "articleId",
     "scheduledAt",
     "timeZone"
    ]
