      "maxLength": 160
     },
     "endpointUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https:\\/\\/.*"
     },
     "webhookToken": {
      "type": "string",
      "minLength": 32,
      "maxLength": 1000
     },
     "publicUrlTemplate": {
      "type": "string",
      "format": "uri",
      "pattern": "^https:\\/\\/.*"
     },
     "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
     },
     "connectionId": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
